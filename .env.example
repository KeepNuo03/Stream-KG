# === App ===
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATA_DIR=./data

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_CHUNKS=chunks
QDRANT_COLLECTION_ENTITIES=entities

# === SQLite ===
SQLITE_PATH=./data/meta.db

# === Graph ===
GRAPH_PATH=./data/graph.pkl

# === Local Models ===
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 国内网络优先 modelscope；已下载可填本地目录 EMBEDDING_MODEL_LOCAL_PATH
EMBEDDING_DOWNLOAD_SOURCE=modelscope
EMBEDDING_MODEL_LOCAL_PATH=
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_SERVER_URL=http://localhost:8081
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SEC=2.0
EMBEDDING_FALLBACK_COOLDOWN_SEC=60

RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_SERVER_URL=http://localhost:8082
RERANKER_ENABLED=false

# === LLM API (DeepSeek) ===
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# === MinerU ===
MINERU_DEVICE=cuda
MINERU_OUTPUT_DIR=./data/parsed
MINERU_CLI=mineru
MINERU_BACKEND=pipeline
MINERU_SOURCE=modelscope
MINERU_TIMEOUT_SEC=1800

# === Web Fetch ===
WEB_FETCH_TIMEOUT_SEC=20
WEB_FETCH_COOKIE=

# === Chunking ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === Entity Resolution (C1) ===
RESOLVE_ALPHA=0.60
RESOLVE_BETA=0.25
RESOLVE_GAMMA=0.15
RESOLVE_THRESHOLD=0.82
RESOLVE_TOP_K=20

# === Retrieval ===
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
GRAPH_HOP=2
RAG_MAX_CONTEXT_CHARS_PER_CHUNK=1200
RAG_MIN_RELEVANCE_SCORE=0.38
RAG_LOW_RELEVANCE_MARGIN=0.04
RAG_EVIDENCE_FALLBACK_MIN_SCORE=0.48
RAG_LOW_RELEVANCE_MARGIN=0.02

# === Ingestion polling ===
INGEST_POLL_INTERVAL_SEC=2

# === Feature Flags ===
FEATURE_KG_ENABLED=false
FEATURE_RERANKER_ENABLED=false
FEATURE_GRAPH_ROUTER_ENABLED=false

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
